# Копирай като .env (НЕ комитвай .env)
ENVIRONMENT=development
DEBUG=false

POSTGRES_USER=trading
POSTGRES_PASSWORD=trading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_platform

# По избор: пълен URL, който има приоритет пред POSTGRES_* променливите
# DATABASE_URL=postgresql+psycopg2://trading:trading@localhost:5432/trading_platform

DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
